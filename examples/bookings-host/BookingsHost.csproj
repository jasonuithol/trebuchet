<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generated/ is its own project; keep its sources out of this project's default glob. -->
    <Compile Remove="Generated/**" />
    <None Remove="Generated/**" />
    <Content Remove="Generated/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Regenerate Generated/ with the treb emit command shown in README.md (with the host flag). -->
    <ProjectReference Include="Generated/Generated.csproj" />
  </ItemGroup>
</Project>
