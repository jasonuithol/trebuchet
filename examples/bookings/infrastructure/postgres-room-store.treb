module bookings.infrastructure.postgres

// Adapter: RoomStore backed by Postgres. Satisfies the RoomStore shape structurally.

use bookings.domain.ids
use bookings.domain.booking
use bookings.domain.events
use bookings.application.ports
use bookings.infrastructure.sql

service PgRoomStore(db: PgConnection)
  fn load(id: RoomId) -> Result[Vector[RoomEvent], BookingError]
    rows = db.query("select payload from room_events where room_id = $1 order by seq", [id.value])?
    ok(map(rows, \r -> json.decode[RoomEvent](r.payload)))

  fn append(id: RoomId, events: Vector[RoomEvent]) -> Result[Unit, BookingError]
    forEach(events, \e -> db.exec("insert into room_events (room_id, payload) values ($1, $2)", [id.value, json.encode(e)]))
    ok(unit)

  fn roomIds() -> Result[Vector[RoomId], BookingError]
    rows = db.query("select id as name, 0 as capacity, '' as payload from rooms", [])?
    ok(map(rows, \r -> RoomId(r.name)))

  fn seed(id: RoomId) -> Result[Room, BookingError]
    match db.queryOne("select name, capacity from rooms where id = $1", [id.value])?
      None => error(BookingError.RoomNotFound(id))
      Some(r) => ok(Room(id, r.name, r.capacity, []))
