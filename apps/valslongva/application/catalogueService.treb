module valslongva.application.catalogueService

// The Thunderstore listing, fetched at most every six hours: memory first, then the disk
// copy, then the network. Decoding a document we did not write is a supervised step.
use valslongva.domain.catalogue
use valslongva.application.ports
use valslongva.application.errors

service CatalogueService(http: Http, fs: FileSystem, platform: Platform, clock: Clock, cache: Cell[Option[Catalogue]])
        private fn listingPath() -> String
                platform.dataDir() + "/catalogue.json"

        private fn stampPath() -> String
                platform.dataDir() + "/catalogue.fetched"

        private fn isFresh(cat: Catalogue) -> Bool
                Instant.secondsBetween(cat.fetchedAt, clock.now()) < 6 * 3600

        private fn decode(text: String, fetchedAt: Instant) -> Result[Catalogue, AppError]
                packages = supervise json.decode[Vector[Listing]](text)
                ok(index(packages.mapError(crashed)?, fetchedAt))

        // What is loaded, without loading anything.
        fn loaded() -> Option[Catalogue]
                cache.get()

        // Whatever is at hand, at once: memory, else the disk copy however old, and the network only
        // when there is nothing. A stale catalogue is still a catalogue; refreshing it is a separate
        // request the caller makes in the background.
        fn current() -> Result[Catalogue, AppError]
                match cache.get()
                        Some(cat) => ok(cat)
                        None =>
                                if fs.exists(listingPath()) and fs.exists(stampPath()) then
                                        text = fs.readText(listingPath()).mapError(io)?
                                        stamp = fs.readText(stampPath()).mapError(io)?
                                        cat = decode(text, Instant.parse(trim(stamp)))?
                                        cache.set(Some(cat))
                                        ok(cat)
                                else
                                        refresh()

        fn stale() -> Bool
                match cache.get()
                        Some(cat) => not isFresh(cat)
                        None => false

        // The listing is 170 MB: it is streamed to a file beside the old one and read from there, never
        // held as a response in memory, and it replaces the old copy only once it has decoded.
        fn refresh() -> Result[Catalogue, AppError]
                now = clock.now()
                staged = listingPath() + ".new"
                fs.ensureDir(platform.dataDir()).mapError(io)?
                http.download(listingUrl(), staged).mapError(net)?
                text = fs.readText(staged).mapError(io)?
                cat = decode(text, now)?
                fs.moveTree(staged, listingPath()).mapError(io)?
                fs.writeText(stampPath(), toString(now)).mapError(io)?
                cache.set(Some(cat))
                ok(cat)

fn listingUrl() -> String ! Pure
        "https://thunderstore.io/c/valheim/api/v1/package/"

fn emptyCache() -> Cell[Option[Catalogue]]
        Cell.new(None)
