module valslongva.domain.release

// The program's own releases. GitHub's releases/latest address redirects to the newest tag, with
// no API and so no rate limit; the tag names the version and the files' addresses follow from
// it. Whether that tag is an update for this build is a pure question.

use valslongva.domain.version

fn appVersion() -> String ! Pure
        "0.2.3"

record Update
        version: String
        asset: String
        url: String

union UpdateOutcome
        UpToDate
        NotUpdatable
        Updated(version: String)

fn tagPrefix() -> String ! Pure
        "valslongva-v"

fn assetFor(os: String) -> String ! Pure
        if os == "windows" then "valslongva-win-x64.zip" else "valslongva-linux-x64.tar.gz"

fn newer(a: String, b: String) -> Bool ! Pure
        match (parseVersion(a), parseVersion(b))
                (Some(x), Some(y)) => x > y
                _ => false

// The tag a release page's address ends in: .../releases/tag/valslongva-v1.2.3
fn tagOf(location: String) -> Option[String] ! Pure
        marker = "/releases/tag/"
        match indexOf(location, marker)
                None => None
                Some(i) =>
                        rest = substring(location, i + length(marker), length(location))
                        tag = match split(rest, "?")
                                [first, ..._] => first
                                _ => rest
                        if length(tag) > 0 and not contains(tag, "/") then Some(tag) else None

fn versionOfTag(tag: String) -> Option[Version] ! Pure
        if startsWith(tag, tagPrefix()) then parseVersion(substring(tag, length(tagPrefix()), length(tag))) else None

// Where the latest release redirects to decides everything: a tag of ours, newer than what is
// running, yields the address of this platform's file beside it. Anything else is no update.
fn updateFromLatest(current: String, os: String, location: String) -> Option[Update] ! Pure
        match tagOf(location)
                None => None
                Some(tag) =>
                        match versionOfTag(tag)
                                None => None
                                Some(v) =>
                                        if newer(showVersion(v), current) then
                                                Some(Update(showVersion(v), assetFor(os), replace(location, "/releases/tag/" + tag, "/releases/download/" + tag + "/" + assetFor(os))))
                                        else
                                                None

fn prop_neverOffersWhatIsNotNewer(current: Version, latest: Version) -> Bool ! Pure
        location = "https://example.test/o/r/releases/tag/" + tagPrefix() + showVersion(latest)
        match updateFromLatest(showVersion(current), "linux", location)
                Some(u) => newer(u.version, showVersion(current))
                None => true

fn prop_aNewerTagYieldsItsOwnDownloadAddress(v: Version) -> Bool ! Pure
        valid = v.major >= 0 and v.minor >= 0 and v.patch >= 0 and (v.major > 0 or v.minor > 0 or v.patch > 0)
        tag = tagPrefix() + showVersion(v)
        wanted = Some(Update(showVersion(v), "valslongva-win-x64.zip", "https://example.test/o/r/releases/download/" + tag + "/valslongva-win-x64.zip"))
        if valid then updateFromLatest("0.0.0", "windows", "https://example.test/o/r/releases/tag/" + tag) == wanted else true

fn prop_someoneElsesTagIsNeverAnUpdate(name: String, v: Version) -> Bool ! Pure
        clean = replace(replace(name, "/", ""), "?", "")
        tag = "other" + clean + "-v" + showVersion(v)
        updateFromLatest("0.0.0", "linux", "https://example.test/o/r/releases/tag/" + tag) == None

fn prop_anAddressWithoutATagIsNoUpdate(text: String) -> Bool ! Pure
        if contains(text, "/releases/tag/") then true else updateFromLatest("0.0.0", "linux", text) == None
