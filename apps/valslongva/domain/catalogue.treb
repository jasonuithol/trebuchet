module valslongva.domain.catalogue

// Thunderstore's package listing, as the JSON boundary reads it. Field names bind leniently,
// so full_name in the document lands in fullName here and the fields we do not declare are
// ignored. Versions arrive newest first.
use valslongva.domain.version
use valslongva.domain.packages

record ListingVersion
        name: String
        fullName: String
        versionNumber: String
        dependencies: Vector[String]
        description: String
        downloadUrl: String
        downloads: Int
        fileSize: Int
        websiteUrl: String
        icon: String
        dateCreated: String

record Listing
        name: String
        owner: String
        fullName: String
        packageUrl: String
        categories: Vector[String]
        isDeprecated: Bool
        isPinned: Bool
        ratingScore: Int
        dateUpdated: String
        versions: Vector[ListingVersion]

// What the program keeps of a listing. The document carries every field of every version, a
// hundred thousand of them; all that is ever asked is the newest version in full, the total
// downloads, and which version numbers exist. Kept whole, the catalogue held 400 MB live.
record Package
        name: String
        owner: String
        fullName: String
        packageUrl: String
        categories: Vector[String]
        isDeprecated: Bool
        ratingScore: Int
        dateUpdated: String
        latest: Option[ListingVersion]
        downloads: Int
        versions: Vector[String]

record Catalogue
        packages: Vector[Package]
        byName: Map[String, Package]
        fetchedAt: Instant

// The listings arrive as a lazy sequence and each is condensed as it is read, so the full
// listings never exist all at once.
fn index(listings: Seq[Listing], fetchedAt: Instant) -> Catalogue ! Pure
        packages = toVector(map(listings, condense))
        Catalogue(packages, fold(packages, {}, \m, p -> m.set(p.fullName, p)), fetchedAt)

fn lookup(cat: Catalogue, name: String) -> Option[Package] ! Pure
        cat.byName.get(name)

// The newest version, by number rather than by position, since the listing is data we did not write.
fn latest(l: Listing) -> Option[ListingVersion] ! Pure
        fn newer(acc: Option[ListingVersion], v: ListingVersion) -> Option[ListingVersion]
                match (acc, parseVersion(v.versionNumber))
                        (None, _) => Some(v)
                        (Some(best), Some(pv)) =>
                                match parseVersion(best.versionNumber)
                                        Some(bv) => if pv > bv then Some(v) else acc
                                        None => Some(v)
                        _ => acc
        fold(l.versions, None, newer)

fn totalDownloads(l: Listing) -> Int ! Pure
        fold(l.versions, 0, \n, v -> n + v.downloads)

fn condense(l: Listing) -> Package ! Pure
        Package(l.name, l.owner, l.fullName, l.packageUrl, l.categories, l.isDeprecated, l.ratingScore, l.dateUpdated, latest(l), totalDownloads(l), map(l.versions, \v -> v.versionNumber))

fn prop_condensingKeepsWhatIsAsked(l: Listing) -> Bool ! Pure
        p = condense(l)
        p.latest == latest(l) and p.downloads == totalDownloads(l) and p.versions == map(l.versions, \v -> v.versionNumber)

fn prop_latestIsMaximal(l: Listing) -> Bool ! Pure
        match latest(l)
                None => isEmpty(l.versions)
                Some(best) =>
                        match parseVersion(best.versionNumber)
                                None => true
                                Some(bv) =>
                                        fn notNewer(v: ListingVersion) -> Bool
                                                match parseVersion(v.versionNumber)
                                                        Some(pv) => pv <= bv
                                                        None => true
                                        all(l.versions, notNewer)
