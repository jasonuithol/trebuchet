module valslongva.api.api

// The HTTP edge. Method names are routes: getStatus is GET /status, postInstall is POST
// /install. Scalars bind from the query string or the JSON body. Calls into the installer
// and launcher are supervised: a panic there is an Internal error, not a dead server.
use valslongva.domain.packages
use valslongva.domain.release
use valslongva.domain.steam
use valslongva.domain.scan
use valslongva.domain.catalogue
use valslongva.domain.library
use valslongva.domain.paging
use valslongva.application.ports
use valslongva.application.errors
use valslongva.application.settings
use valslongva.application.locator
use valslongva.application.catalogueService
use valslongva.application.search
use valslongva.application.installer
use valslongva.application.launcher
use valslongva.application.steamStatus
use valslongva.application.updater

record Status
        os: String
        version: String
        gameDir: Option[String]
        gameProblem: Option[String]
        candidates: Vector[String]
        // BepInEx: the version valslöngva installed, whether its core dll is there at all, the dll's
        // own file version when it is, and the newest pack Thunderstore has
        loader: Option[String]
        loaderPresent: Bool
        loaderDetected: Option[String]
        loaderLatest: Option[String]
        // the pack's icon on Thunderstore, so the UI can show it without a copy in this repository
        loaderIcon: Option[String]
        steam: SteamState
        installed: Int
        // this request's scan of the plugins folder: adopted just now, and what is there unmanaged
        adopted: Vector[String]
        unmanaged: Vector[UnmanagedView]
        catalogueFetchedAt: Option[Instant]
        cataloguePackages: Int
        catalogueStale: Bool

// What changes without the user touching anything: polled every few seconds.
record Pulse
        steam: SteamState
        version: String

record UnmanagedView
        entry: String
        isFolder: Bool
        pluginName: Option[String]
        pluginVersion: Option[String]
        guid: Option[String]
        suggestion: Option[String]
        // the plugin's own version is one Thunderstore has for the suggested package; when it is not,
        // this is a local build and replacing it loses something Thunderstore cannot give back
        onThunderstore: Bool
        suggestedVersion: Option[String]

record InstalledView
        pkg: String
        version: String
        enabled: Bool
        latestVersion: Option[String]
        installedAt: Instant
        adopted: Bool
        // what the catalogue knows about the package it came from, once the catalogue is loaded
        summary: Option[ListingSummary]

record PackageDetail
        summary: ListingSummary
        versions: Vector[String]
        packageUrl: String

service Api(installer: Installer, catalogue: CatalogueService, launcher: Launcher, locator: Locator, settings: SettingsStore, platform: Platform, fs: FileSystem, steam: SteamStatus, updater: Updater)
        private fn catalogueStamp() -> Option[Instant]
                map(catalogue.loaded(), \c -> c.fetchedAt)

        private fn cataloguePackages() -> Int
                match catalogue.loaded()
                        Some(c) => length(c.packages)
                        None => 0

        private fn loaderVersion() -> Option[ListingVersion]
                match catalogue.loaded()
                        None => None
                        Some(c) =>
                                match lookup(c, loaderName())
                                        None => None
                                        Some(l) => l.latest

        private fn loaderLatest() -> Option[String]
                map(loaderVersion(), \v -> v.versionNumber)

        private fn loaderIcon() -> Option[String]
                match loaderVersion()
                        Some(v) => if length(v.icon) == 0 then None else Some(v.icon)
                        None => None

        // A catalogue package for an unmanaged plugin. Names are loose evidence (the plugin DayNight4010
        // ships in the package Ezvay-DayNight, and an older Ezvay-DayNight4010 exists), so among the
        // packages whose name is the plugin's or a prefix of it, one that has the plugin's exact version
        // wins; only then does an exact name count on its own.
        private fn suggestionFor(u: Unmanaged) -> Option[String]
                fn key(s: String) -> String
                        toLower(replace(replace(s, "_", ""), " ", ""))
                wanted = match u.pluginName
                        Some(n) => key(n)
                        None => key(replace(u.entry, ".dll", ""))
                fn related(l: Package) -> Bool
                        k = key(l.name)
                        length(k) > 0 and (k == wanted or startsWith(wanted, k))
                fn hasVersion(l: Package) -> Bool
                        match u.pluginVersion
                                Some(v) => contains(l.versions, v)
                                None => false
                match catalogue.loaded()
                        None => None
                        Some(c) =>
                                candidates = filter(c.packages, related)
                                match find(candidates, hasVersion)
                                        Some(l) => Some(l.fullName)
                                        None =>
                                                match find(candidates, \l -> key(l.name) == wanted)
                                                        Some(l) => Some(l.fullName)
                                                        None => None

        private fn view(u: Unmanaged) -> UnmanagedView
                suggestion = suggestionFor(u)
                listing = match (suggestion, catalogue.loaded())
                        (Some(name), Some(c)) => lookup(c, name)
                        _ => None
                known = match (listing, u.pluginVersion)
                        (Some(l), Some(v)) => contains(l.versions, v)
                        _ => false
                newest = match listing
                        Some(l) => map(l.latest, \lv -> lv.versionNumber)
                        None => None
                UnmanagedView(u.entry, u.isFolder, u.pluginName, u.pluginVersion, u.guid, suggestion, known, newest)

        private fn libraryOrEmpty() -> Library
                match installer.library()
                        Ok(lib) => lib
                        Error(_) => emptyLibrary()

        fn getStatus() -> Result[Status, AppError]
                match locator.gameDir()
                        Error(e) =>
                                ok(Status(platform.os(), appVersion(), None, Some(messageOf(e)), locator.candidates(), None, false, None, loaderLatest(), loaderIcon(), steam.state(), 0, [], [], catalogueStamp(), cataloguePackages(), catalogue.stale()))
                        Ok(dir) =>
                                scanned = installer.scan()?
                                lib = installer.library()?
                                core = dir + "/BepInEx/core/BepInEx.dll"
                                ok(Status(platform.os(), appVersion(), Some(dir), None, locator.candidates(), lib.loader, fs.exists(core), fs.fileVersion(core), loaderLatest(), loaderIcon(), steam.state(), length(lib.mods), scanned.adopted, map(scanned.unmanaged, \u -> view(u)), catalogueStamp(), cataloguePackages(), catalogue.stale()))

        fn getSearch(query: String, sort: String, deprecated: Bool, offset: Int, limit: Int) -> Result[Page[ListingSummary], AppError]
                cat = catalogue.current()?
                ok(searchCatalogue(cat, libraryOrEmpty(), query, sort, deprecated, offset, if limit > 200 then 200 else limit))

        fn getPackage(name: String) -> Result[PackageDetail, AppError]
                cat = catalogue.current()?
                match lookup(cat, name)
                        None => error(AppError.NotFound("no package named " + name))
                        Some(l) =>
                                match summarise(l, libraryOrEmpty())
                                        None => error(AppError.Conflict(name + " has no versions"))
                                        Some(s) => ok(PackageDetail(s, l.versions, l.packageUrl))

        fn getInstalled() -> Result[Vector[InstalledView], AppError]
                installer.scan()?
                lib = installer.library()?
                cat = catalogue.loaded()
                fn listingOf(pkg: String) -> Option[Package]
                        match cat
                                None => None
                                Some(c) => lookup(c, pkg)
                fn latestOf(pkg: String) -> Option[String]
                        match listingOf(pkg)
                                None => None
                                Some(l) => map(l.latest, \v -> v.versionNumber)
                fn summaryOf(pkg: String) -> Option[ListingSummary]
                        match listingOf(pkg)
                                None => None
                                Some(l) => summarise(l, lib)
                ok(map(installedMods(lib), \m -> InstalledView(m.pkg, m.version, m.enabled, latestOf(m.pkg), m.installedAt, m.adopted, summaryOf(m.pkg))))

        fn postInstall(name: String) -> Result[Vector[String], AppError]
                outcome = supervise installer.install(name)
                outcome.mapError(crashed)?

        fn postReinstall(name: String) -> Result[Vector[String], AppError]
                outcome = supervise installer.reinstall(name)
                outcome.mapError(crashed)?

        fn postLoader() -> Result[Vector[String], AppError]
                outcome = supervise installer.installLoader()
                outcome.mapError(crashed)?

        fn postAdopt(entry: String, name: String) -> Result[Unit, AppError]
                installer.adopt(entry, name)

        fn postUninstall(name: String) -> Result[Unit, AppError]
                installer.uninstall(name)

        fn postEnable(name: String) -> Result[Unit, AppError]
                installer.setEnabled(name, true)

        fn postDisable(name: String) -> Result[Unit, AppError]
                installer.setEnabled(name, false)

        fn postLaunch(mode: String) -> Result[String, AppError]
                outcome = supervise launcher.launch(mode)
                outcome.mapError(crashed)?

        fn postGamePath(path: String) -> Result[Status, AppError]
                chosen = if length(trim(path)) == 0 then None else Some(replace(trim(path), "\\", "/"))
                settings.save(Settings(chosen))?
                getStatus()

        fn getPulse() -> Result[Pulse, AppError]
                ok(Pulse(steam.state(), appVersion()))

        // Replace this program with a newer release if there is one; the host restarts it afterwards.
        fn postSelfupdate() -> Result[UpdateOutcome, AppError]
                outcome = supervise updater.update()
                outcome.mapError(crashed)?

        fn postRefresh() -> Result[Status, AppError]
                catalogue.refresh()?
                getStatus()
