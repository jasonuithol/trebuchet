module valslongva.host.main

// The real thing: host adapters over the externs, one catalogue cache for the process.
use valslongva.application.settings
use valslongva.application.locator
use valslongva.application.catalogueService
use valslongva.application.installer
use valslongva.application.launcher
use valslongva.application.steamStatus
use valslongva.application.updater
use valslongva.infrastructure.host
use valslongva.api.api

root main
        platform: HostPlatform
        clock: SystemClock
        fs: HostFileSystem
        http: HostHttp
        archive: HostArchive
        processes: HostProcesses
        client: HostSteam
        program: HostProgram
        cache: emptyCache()
        settings: SettingsStore
        locator: Locator
        catalogue: CatalogueService
        installer: Installer
        steam: SteamStatus
        launcher: Launcher
        updater: Updater
        api: Api
