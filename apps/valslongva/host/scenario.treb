module valslongva.host.scenario

// End-to-end through the fakes: install a mod, get its loader for free, disable it, launch.
// A scenario writes, so it is a handler; treb test runs a parameterless property once.
use valslongva.domain.library
use valslongva.application.settings
use valslongva.application.locator
use valslongva.application.catalogueService
use valslongva.application.installer
use valslongva.application.launcher
use valslongva.application.profiles
use valslongva.domain.profiles
use valslongva.domain.links
use valslongva.application.steamStatus
use valslongva.application.updater
use valslongva.domain.release
use valslongva.domain.steam
use valslongva.domain.scan
use valslongva.infrastructure.fakes
use valslongva.host.fixture
use valslongva.api.api

record World
        api: Api
        fs: FakeFileSystem
        processes: FakeProcesses
        program: FakeProgram

fn world() -> World
        worldWith(FakeSteam(true), seededFiles())

fn worldWith(steamClient: FakeSteam, files: Cell[Map[String, String]]) -> World
        worldFull(steamClient, files, FakeProgram(false, releasesFeed(), emptyLog()))

fn worldFull(steamClient: FakeSteam, files: Cell[Map[String, String]], program: FakeProgram) -> World
        platform = FakePlatform("linux", "/home/viking", "/home/viking/.local/share/valslongva")
        clock = FixedClock(Instant.parse("2026-09-30T10:00:00Z"))
        fs = FakeFileSystem(files)
        http = FakeHttp(fixturePages(), fs)
        archive = FakeArchive(fixtureArchives(), fs)
        processes = FakeProcesses(emptyLog())
        settings = SettingsStore(fs, platform)
        locator = Locator(fs, platform, settings)
        catalogue = CatalogueService(http, fs, platform, clock, emptyCache())
        installer = Installer(fs, http, archive, platform, clock, catalogue, locator)
        steam = SteamStatus(steamClient, fs, locator)
        profiles = Profiles(fs, locator, settings, installer)
        launcher = Launcher(fs, processes, platform, locator, installer, steam, profiles)
        updater = Updater(http, fs, archive, platform, program)
        World(Api(installer, catalogue, launcher, locator, settings, platform, fs, steam, updater, processes, profiles), fs, processes, program)

handler prop_startsSteamOnlyWhenItIsNotRunning() -> Bool
        down = worldWith(FakeSteam(false), seededFiles())
        up = world()
        match (down.api.postSteam(), up.api.postSteam())
                (Ok(NotRunning), Ok(Connected)) => down.processes.entries() == ["start steam"] and isEmpty(up.processes.entries())
                _ => false

// A published build finds the newest real release, unpacks it, swaps itself, and restarts.
handler prop_updatesItselfWhenANewerReleaseExists() -> Bool
        w = worldFull(FakeSteam(true), seededFiles(), FakeProgram(true, releasesFeed(), emptyLog()))
        dir = "/home/viking/.local/share/valslongva/update/9.9.9"
        match w.api.postSelfupdate()
                Ok(Updated(v)) => v == "9.9.9" and w.program.entries() == ["replace " + dir, "restart"] and contains(w.fs.snapshot(), dir + "/valslongva") and contains(w.fs.snapshot(), dir + "/ui/index.html")
                _ => false

handler prop_aDevelopersRunNeverReplacesItself() -> Bool
        w = world()
        match w.api.postSelfupdate()
                Ok(NotUpdatable) => isEmpty(w.program.entries())
                _ => false

// An old catalogue on disk is served at once and reported stale; refreshing is a separate request.
handler prop_servesAStaleCatalogueAndSaysSo() -> Bool
        files = seededFiles()
        data = "/home/viking/.local/share/valslongva"
        files.update(\m -> m.set(data + "/catalogue.json", listingText()).set(data + "/catalogue.fetched", "2026-09-29T00:00:00Z"))
        w = worldWith(FakeSteam(true), files)
        served = match (w.api.getSearch("", "name", true, 0, 5), w.api.getStatus())
                (Ok(page), Ok(s)) => page.total == 2 and s.catalogueStale and s.catalogueFetchedAt == Some(Instant.parse("2026-09-29T00:00:00Z"))
                _ => false
        refreshed = match w.api.postRefresh()
                Ok(s) => not s.catalogueStale
                Error(_) => false
        served and refreshed

handler prop_thePulseCarriesSteamAndTheVersion() -> Bool
        w = worldWith(FakeSteam(false), seededFiles())
        match w.api.getPulse()
                Ok(p) => p.steam == SteamState.NotRunning and p.version == appVersion()
                Error(_) => false

handler prop_launchNeedsSteam() -> Bool
        w = worldWith(FakeSteam(false), seededFiles())
        refused = match (w.api.postLoader(), w.api.postLaunch("vanilla"))
                (Ok(_), Error(Conflict(_))) => true
                _ => false
        reported = match w.api.getStatus()
                Ok(s) => s.steam == SteamState.NotRunning
                Error(_) => false
        refused and reported and w.processes.entries() == []

handler prop_extraArgumentsReachTheGame() -> Bool
        w = world()
        saved = match w.api.postLaunchArgs("  -console \"-window-mode exclusive\" ")
                Ok(s) => s.launchArgs == "-console \"-window-mode exclusive\""
                Error(_) => false
        launched = match w.api.postLaunch("vanilla")
                Ok(_) => w.processes.entries() == ["run " + gameDir() + "/valheim.x86_64 in " + gameDir() + " with -console -window-mode exclusive"]
                Error(_) => false
        // clearing the field clears the setting, and the game folder choice survives both writes
        cleared = match (w.api.postLaunchArgs(""), w.api.getStatus())
                (Ok(_), Ok(s)) => s.launchArgs == "" and s.gameDir == Some(gameDir())
                _ => false
        saved and launched and cleared

handler prop_profilesChooseWhichModsAreOn() -> Bool
        w = world()
        plugin = gameDir() + "/BepInEx/plugins/viking-Longship/Longship.dll"
        fn modsOf(set: ProfileSet, name: String) -> Vector[String]
                match findProfile(set, name)
                        Some(p) => p.mods
                        None => ["?"]
        installed = match w.api.postInstall("viking-Longship")
                Ok(_) => true
                Error(_) => false
        // a new profile copies the active one and does not become active by itself
        created = match w.api.postProfileCreate(" Testing ")
                Ok(set) => set.active == "Default" and length(set.profiles) == 2 and modsOf(set, "Testing") == ["viking-Longship"]
                Error(_) => false
        // switching to it, then disabling the mod, changes only that profile
        narrowed = match (w.api.postProfileSwitch("Testing"), w.api.postDisable("viking-Longship"), w.api.getProfiles())
                (Ok(_), Ok(_), Ok(set)) => set.active == "Testing" and modsOf(set, "Testing") == [] and modsOf(set, "Default") == ["viking-Longship"]
                _ => false
        // the card can say where a mod is on: here only in Default
        placed = match w.api.getInstalled()
                Ok(mods) => map(mods, \m -> m.onIn) == [["Default"]]
                Error(_) => false
        // switching back brings the folder back, and the status names the profile
        restored = match (w.api.postProfileSwitch("default"), w.api.getStatus())
                (Ok(set), Ok(s)) => set.active == "Default" and s.profile == "Default" and contains(w.fs.snapshot(), plugin)
                _ => false
        // Default stays; the other goes; an uninstall drops the mod from every profile
        removed = match (w.api.postProfileRemove("Default"), w.api.postProfileRemove("Testing"))
                (Error(BadRequest(_)), Ok(set)) => length(set.profiles) == 1
                _ => false
        installed and created and narrowed and placed and restored and removed

handler prop_launchArgumentsBelongToTheProfile() -> Bool
        w = world()
        // arguments saved before profiles existed seed the Default profile
        seeded = match (w.fs.writeText("/home/viking/.local/share/valslongva/settings.json", "{\"gamePath\": null, \"launchArgs\": \"-old\"}"), w.api.getStatus())
                (Ok(_), Ok(s)) => s.launchArgs == "-old" and s.profile == "Default"
                _ => false
        varied = match (w.api.postProfileCreate("Loud"), w.api.postProfileSwitch("Loud"), w.api.postLaunchArgs("-console"))
                (Ok(_), Ok(_), Ok(s)) => s.launchArgs == "-console" and s.profile == "Loud"
                _ => false
        launched = match (w.api.postLaunch("vanilla"), w.api.postProfileSwitch("Default"), w.api.postLaunch("vanilla"))
                (Ok(_), Ok(_), Ok(_)) => w.processes.entries() == ["run " + gameDir() + "/valheim.x86_64 in " + gameDir() + " with -console", "run " + gameDir() + "/valheim.x86_64 in " + gameDir() + " with -old"]
                _ => false
        seeded and varied and launched

handler prop_aThunderstoreLinkInstallsThePackage() -> Bool
        w = world()
        installed = match w.api.postLink("ror2mm://v1/install/thunderstore.io/viking/Longship/1.0.0/")
                Ok(o) => o.package == "viking-Longship" and o.version == "1.0.0" and contains(o.installed, "viking-Longship-1.2.0") and contains(w.fs.snapshot(), gameDir() + "/BepInEx/plugins/viking-Longship/Longship.dll")
                Error(_) => false
        refused = match w.api.postLink("https://thunderstore.io/c/valheim/p/viking/Longship/")
                Error(BadRequest(_)) => true
                _ => false
        installed and refused

handler prop_aPluginManagedBeforeItsCompanionsCountedPicksThemUp() -> Bool
        files = seededFiles()
        log = "{\"type\": \"ModAdopted\", \"pkg\": \"viking-Longship\", \"version\": \"1.1.0\", \"files\": [\"BepInEx/plugins/Longship.dll\"], \"at\": \"2026-09-30T09:00:00Z\"}\n"
        files.update(\m -> m.set(gameDir() + "/valslongva/library.jsonl", log).set(gameDir() + "/BepInEx/plugins/Longship.dll", "plugin:viking.longship|Longship|1.1.0").set(gameDir() + "/BepInEx/plugins/Longship.pdb", "symbols"))
        w = worldWith(FakeSteam(true), files)
        match (w.api.getStatus(), w.fs.readText(gameDir() + "/valslongva/library.jsonl"))
                (Ok(s), Ok(text)) => s.installed == 1 and isEmpty(s.unmanaged) and contains(text, "Longship.pdb") and length(filter(lines(text), \l -> contains(l, "ModAdopted"))) == 2
                _ => false

handler prop_anAdoptedModDisablesByItsOwnFiles() -> Bool
        files = seededFiles()
        // a folder that is not Thunderstore-packaged, managed on request: its folder is not named after the package
        folder = gameDir() + "/BepInEx/plugins/Longship"
        files.update(\m -> m.set(folder + "/Longship.dll", "plugin:viking.longship|Longship|1.1.0").set(folder + "/Longship.pdb", "symbols"))
        w = worldWith(FakeSteam(true), files)
        parked = gameDir() + "/valslongva/disabled/viking-Longship/Longship/Longship.dll"
        adopted = match (w.api.getSearch("", "name", true, 0, 5), w.api.postAdopt("Longship", "viking-Longship"))
                (Ok(_), Ok(_)) => true
                _ => false
        off = match w.api.postDisable("viking-Longship")
                Ok(_) => not contains(w.fs.snapshot(), folder + "/Longship.dll") and contains(w.fs.snapshot(), parked) and contains(w.fs.snapshot(), gameDir() + "/valslongva/disabled/viking-Longship/Longship/Longship.pdb")
                Error(_) => false
        on = match w.api.postEnable("viking-Longship")
                Ok(_) => contains(w.fs.snapshot(), folder + "/Longship.dll") and contains(w.fs.snapshot(), folder + "/Longship.pdb") and not contains(w.fs.snapshot(), parked)
                Error(_) => false
        // uninstalling while disabled still backs the parked files up
        kept = match (w.api.postDisable("viking-Longship"), w.api.postUninstall("viking-Longship"))
                (Ok(_), Ok(_)) =>
                        snap = w.fs.snapshot()
                        backed = any(keys(snap), \k -> startsWith(k, gameDir() + "/valslongva/backup/viking-Longship/") and endsWith(k, "/BepInEx/plugins/Longship/Longship.pdb"))
                        backed and not contains(snap, parked)
                _ => false
        adopted and off and on and kept

handler prop_findsTheGameInTheSteamLibrary() -> Bool
        w = world()
        match w.api.getStatus()
                Ok(s) => s.gameDir == Some(gameDir()) and not s.loaderPresent and s.installed == 0
                Error(_) => false

handler prop_statusReportsTheLoaderBeforeAndAfter() -> Bool
        w = world()
        before = match w.api.getStatus()
                Ok(s) => not s.loaderPresent and s.loader == None and s.loaderDetected == None
                Error(_) => false
        after = match (w.api.postLoader(), w.api.getStatus())
                (Ok(_), Ok(s)) => s.loaderPresent and s.loader == Some("5.4.2202") and s.loaderDetected == Some("5.4.23.5") and s.loaderLatest == Some("5.4.2202")
                _ => false
        before and after

handler prop_installingAModBringsItsLoader() -> Bool
        w = world()
        match w.api.postInstall("viking-Longship")
                Error(_) => false
                Ok(done) =>
                        files = w.fs.snapshot()
                        checks =
                                - done == ["denikson-BepInExPack_Valheim-5.4.2202", "viking-Longship-1.2.0"]
                                - contains(files, gameDir() + "/BepInEx/core/BepInEx.dll")
                                - contains(files, gameDir() + "/BepInEx/plugins/viking-Longship/Longship.dll")
                                - contains(files, gameDir() + "/BepInEx/plugins/viking-Longship/manifest.json")
                                - contains(files, gameDir() + "/BepInEx/config/viking.longship.cfg")
                                - not contains(files, gameDir() + "/manifest.json")
                        all(checks, \c -> c)

handler prop_secondInstallIsANoOp() -> Bool
        w = world()
        match (w.api.postInstall("viking-Longship"), w.api.postInstall("viking-Longship"))
                (Ok(_), Ok(again)) => again == []
                _ => false

handler prop_disableMovesTheFolderAndEnableBringsItBack() -> Bool
        w = world()
        match (w.api.postInstall("viking-Longship"), w.api.postDisable("viking-Longship"))
                (Ok(_), Ok(_)) =>
                        moved = w.fs.snapshot()
                        away = not contains(moved, gameDir() + "/BepInEx/plugins/viking-Longship/Longship.dll") and contains(moved, gameDir() + "/valslongva/disabled/viking-Longship/Longship.dll")
                        match w.api.postEnable("viking-Longship")
                                Ok(_) => away and contains(w.fs.snapshot(), gameDir() + "/BepInEx/plugins/viking-Longship/Longship.dll")
                                Error(_) => false
                _ => false

handler prop_uninstallRemovesTheModButKeepsItsConfig() -> Bool
        w = world()
        match (w.api.postInstall("viking-Longship"), w.api.postUninstall("viking-Longship"))
                (Ok(_), Ok(_)) =>
                        files = w.fs.snapshot()
                        not contains(files, gameDir() + "/BepInEx/plugins/viking-Longship/Longship.dll") and contains(files, gameDir() + "/BepInEx/config/viking.longship.cfg")
                _ => false

handler prop_moddedLaunchNeedsTheLoader() -> Bool
        w = world()
        match w.api.postLaunch("modded")
                Error(Conflict(_)) => true
                _ => false

handler prop_linuxLaunchRunsTheScriptOrTheGame() -> Bool
        w = world()
        match (w.api.postLoader(), w.api.postLaunch("modded"), w.api.postLaunch("vanilla"))
                (Ok(_), Ok(_), Ok(_)) => w.processes.entries() == ["run " + gameDir() + "/start_game_bepinex.sh in " + gameDir(), "run " + gameDir() + "/valheim.x86_64 in " + gameDir()]
                _ => false

// A Thunderstore-packaged folder someone else put there is adopted on the first look, once.
handler prop_adoptsAPackagedFolderFoundInThePluginsFolder() -> Bool
        files = seededFiles()
        folder = gameDir() + "/BepInEx/plugins/viking-Longship"
        files.update(\m -> m.set(folder + "/manifest.json", "{\"name\": \"Longship\", \"version_number\": \"1.1.0\", \"description\": \"x\", \"dependencies\": []}").set(folder + "/Longship.dll", "plugin:viking.longship|Longship|1.1.0"))
        w = worldWith(FakeSteam(true), files)
        first = match w.api.getStatus()
                Ok(s) => s.adopted == ["viking-Longship"] and s.installed == 1 and isEmpty(s.unmanaged)
                Error(_) => false
        second = match w.api.getStatus()
                Ok(s) => isEmpty(s.adopted) and s.installed == 1
                Error(_) => false
        listed = match w.api.getInstalled()
                Ok(mods) => map(mods, \m -> m.pkg + " " + m.version) == ["viking-Longship 1.1.0"]
                Error(_) => false
        first and second and listed

// A loose dll is reported with what its attribute says, suggested when the catalogue has its name, and adopted only on request.
handler prop_reportsALooseDllAndAdoptsItOnRequest() -> Bool
        files = seededFiles()
        // a loose plugin often comes with symbols and documentation beside it; they are part of it
        files.update(\m -> m.set(gameDir() + "/BepInEx/plugins/Longship.dll", "plugin:viking.longship|Longship|1.1.0").set(gameDir() + "/BepInEx/plugins/Longship.pdb", "symbols").set(gameDir() + "/BepInEx/plugins/Longship.dll.mdb", "mono symbols").set(gameDir() + "/BepInEx/plugins/Longship.xml", "<doc/>").set(gameDir() + "/BepInEx/plugins/DayNight.dll", "plugin:tarbaby.daynight|DayNight|2.0.0"))
        w = worldWith(FakeSteam(true), files)
        loaded = match w.api.getSearch("", "name", true, 0, 5)
                Ok(_) => true
                Error(_) => false
        reported = match w.api.getStatus()
                Ok(s) => s.installed == 0 and map(s.unmanaged, \u -> u.entry + ":" + getOr(u.pluginName, "?") + ":" + getOr(u.suggestion, "-")) == ["DayNight.dll:DayNight:-", "Longship.dll:Longship:viking-Longship"]
                Error(_) => false
        adopted = match (w.api.postAdopt("Longship.dll", "viking-Longship"), w.api.getStatus())
                (Ok(_), Ok(s)) => s.installed == 1 and length(s.unmanaged) == 1
                _ => false
        flagged = match w.api.getInstalled()
                Ok(mods) => map(mods, \m -> m.adopted) == [true]
                Error(_) => false
        replaced = match (w.api.postReinstall("viking-Longship"), w.api.getInstalled())
                (Ok(done), Ok(mods)) =>
                        snap = w.fs.snapshot()
                        backedUp = all(["Longship.dll", "Longship.pdb", "Longship.dll.mdb", "Longship.xml"], \f -> any(keys(snap), \k -> startsWith(k, gameDir() + "/valslongva/backup/viking-Longship/") and endsWith(k, "/BepInEx/plugins/" + f)))
                        cleared = not any(["Longship.dll", "Longship.pdb", "Longship.dll.mdb", "Longship.xml"], \f -> contains(snap, gameDir() + "/BepInEx/plugins/" + f))
                        done == ["denikson-BepInExPack_Valheim-5.4.2202", "viking-Longship-1.2.0"] and cleared and backedUp and map(mods, \m -> m.adopted) == [false]
                _ => false
        loaded and reported and adopted and flagged and replaced

// A managed mod deleted by hand is noticed on the next look.
handler prop_noticesAManagedModRemovedByHand() -> Bool
        w = world()
        match (w.api.postInstall("viking-Longship"), w.fs.deleteTree(gameDir() + "/BepInEx/plugins/viking-Longship"), w.api.getStatus())
                (Ok(_), Ok(_), Ok(s)) => s.installed == 0
                _ => false

handler prop_searchMarksWhatIsInstalled() -> Bool
        w = world()
        match (w.api.postInstall("viking-Longship"), w.api.getSearch("longship", "downloads", false, 0, 10))
                (Ok(_), Ok(page)) =>
                        hit = match first(page.items)
                                Some(s) => s.installedVersion == Some("1.2.0") and s.latestVersion == "1.2.0" and s.downloads == 100
                                None => false
                        page.total == 1 and hit
                _ => false
